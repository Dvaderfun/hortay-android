# --- Build / Gradle ---
.gradle/
build/
out/
.cxx/
.kotlin/
local.properties
captures/

# --- Android ---
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
release/

# --- TDLib native debug symbols ---
# Produced by scripts/update-tdlib.sh (KEEP_DEBUG=1, default). Used by AGP's
# debugSymbolLevel=FULL to bundle native crash symbols into release AABs;
# the overlay sourceSet `libtdlib/build/tdlib-unstripped` lives under build/
# already, but the snapshot zip in scripts/ is too big for git.
scripts/tdlib-debug-*.zip

# --- IDE: Android Studio / IntelliJ ---
.idea/
*.iml
*.ipr
*.iws

# --- IDE: VS Code / Fleet / Cursor ---
.vscode/
.fleet/

# --- Claude Code agent worktrees / scratch ---
# `.claude/worktrees/agent-*` are temporary git worktrees Claude Code
# creates for `isolation: "worktree"` agent dispatch. They have their own
# `.git` and were being silently picked up as gitlinks (submodule pointers)
# by `git add -A`. Never commit them.
.claude/

# --- macOS / Windows / Linux ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs / temp ---
*.log
*.tmp
*.swp
*~
tdlog.txt

# --- Codegraph MCP index (per-machine, regeneratable) ---
.codegraph/

# --- Gradle daemon JVM config (auto-generated per-machine) ---
gradle/gradle-daemon-jvm.properties

# --- Xcode user state (per-developer, not part of project config) ---
**/xcuserdata/
**/project.xcworkspace/xcuserdata/
**/*.xcodeproj/project.xcworkspace/

# --- Keystores (never commit signing keys) ---
*.jks
*.keystore
keystore.properties

# --- Compose previews / generated reports ---
reports/

# --- Plans (local-only, contain credentials) ---
.plans/

# --- Generated TdApi.kt (28k lines, regenerated by :tdapi-gen:generate) ---
# Matches the Android pattern in libtdlib/.gitignore — generated code stays
# out of git, regen step is part of the toolchain bootstrap. See
# scripts/build-tdlib-apple.sh + scripts/tdapi-gen/.
shared/src/commonMain/kotlin/dev/lyo/hortay/tdlib/TdApi.kt

# iOS local secrets (mirrors local.properties for Android)
iosApp/Local.xcconfig
